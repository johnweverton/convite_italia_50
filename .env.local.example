# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only — NUNCA expor no browser

# Pagamento
NEXT_PUBLIC_PIX_CHAVE=carmem@exemplo.com.br        # chave Pix exibida na página
NEXT_PUBLIC_PIX_NOME=Carmem Glisse Cavalcante       # nome do recebedor (gera o payload do QR)
NEXT_PUBLIC_PIX_CIDADE=FORTALEZA                     # cidade do recebedor (payload Pix)
NEXT_PUBLIC_LINK_CARTAO=https://link.mercadopago... # link de pagamento de cartão externo

# Painel privado
PAINEL_SENHA=troque-esta-senha

# Ingressos / check-in
RESEND_API_KEY=re_...                                    # chave da API do Resend (resend.com)
EMAIL_FROM=Carmem - 50 ANOS <onboarding@resend.dev>       # remetente dos e-mails de ingresso
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app       # usado para montar o link /confirmar/[token] no e-mail
CHECKIN_SENHA=troque-esta-senha                          # senha da portaria, separada da senha do painel

# Prazo de confirmação (encerra em 03/08/2026, ver src/lib/prazo.ts)
NEXT_PUBLIC_CERIMONIALISTA_WHATSAPP=5585999999999        # DDI+DDD+número, sem símbolos, para o botão de contato de urgência
